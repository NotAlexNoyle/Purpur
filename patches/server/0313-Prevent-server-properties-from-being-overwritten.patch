From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Wed, 28 Jan 2026 04:00:00 -0000
Subject: [PATCH] Prevent server.properties from being overwritten


diff --git a/src/main/java/net/minecraft/server/dedicated/DedicatedServerSettings.java b/src/main/java/net/minecraft/server/dedicated/DedicatedServerSettings.java
index 2d3f9c6b3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f..4a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b 100644
--- a/src/main/java/net/minecraft/server/dedicated/DedicatedServerSettings.java
+++ b/src/main/java/net/minecraft/server/dedicated/DedicatedServerSettings.java
@@ -24,7 +24,10 @@ public class DedicatedServerSettings {
     public void update(java.util.function.UnaryOperator<DedicatedServerProperties> unaryoperator) {
         this.properties = unaryoperator.apply(this.properties);
-        this.properties.save(this.path);
+        if (java.nio.file.Files.exists(this.path)) {
+            return;
+        }
+        this.properties.save(this.path);
     }
 
     public void save() {
-        this.properties.save(this.path);
+        if (java.nio.file.Files.exists(this.path)) {
+            return;
+        }
+        this.properties.save(this.path);
     }
 }
