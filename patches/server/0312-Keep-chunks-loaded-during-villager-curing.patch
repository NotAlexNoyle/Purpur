@@ -210,7 +239,65 @@ public class ZombieVillager extends Zombie implements VillagerDataHolder {
 
         super.tick();
         this.lastTick = MinecraftServer.currentTick; // CraftBukkit
+
+        // TrueOG start - the cure can end without finishConversion (cancelled EntityTransformEvent, API setConversionTime(-1))
+        if (!this.level.isClientSide && !this.isConverting()) {
+            this.releaseConversionTicket();
+        }
+        // TrueOG end
+    }
+
+    // TrueOG start - villager curing chunk ticket
+    @Override
+    public void inactiveTick() {
+        super.inactiveTick();
+        this.updateConversionTicket();
+    }
+
+    @Override
+    public void setPos(double x, double y, double z) {
+        super.setPos(x, y, z);
+        if (this.conversionTicketChunk != null && !this.conversionTicketChunk.equals(this.chunkPosition())) {
+            this.updateConversionTicket(); // follow the entity when physics, vehicles, or plugins move it across a chunk border
+        }
+    }
+
+    @Override
+    public void remove(Entity.RemovalReason reason) {
+        this.releaseConversionTicket(); // death, despawn, /kill, discard
+        super.remove(reason);
+    }
+
+    @Override
+    protected void removeAfterChangingDimensions() {
+        this.releaseConversionTicket(); // portal trips and Bukkit cross-world teleports call setRemoved() directly, not remove()
+        super.removeAfterChangingDimensions();
+    }
+
+    private void updateConversionTicket() {
+        if (this.level == null || this.level.isClientSide || !this.isConverting() || !(this.level instanceof ServerLevel serverLevel)) {
+            return;
+        }
+
+        ChunkPos chunkPos = this.chunkPosition();
+        UUID key = this.getUUID();
+        if (this.conversionTicketChunk != null && (!this.conversionTicketChunk.equals(chunkPos) || !key.equals(this.conversionTicketKey))) {
+            serverLevel.getChunkSource().removeRegionTicket(CONVERSION_TICKET, this.conversionTicketChunk, CONVERSION_TICKET_RADIUS, this.conversionTicketKey);
+        }
+        // re-adding an identical ticket replaces it and restarts its expiry
+        serverLevel.getChunkSource().addRegionTicket(CONVERSION_TICKET, chunkPos, CONVERSION_TICKET_RADIUS, key);
+        this.conversionTicketChunk = chunkPos;
+        this.conversionTicketKey = key;
+    }
+
+    private void releaseConversionTicket() {
+        if (this.conversionTicketChunk != null && this.level instanceof ServerLevel serverLevel) {
+            serverLevel.getChunkSource().removeRegionTicket(CONVERSION_TICKET, this.conversionTicketChunk, CONVERSION_TICKET_RADIUS, this.conversionTicketKey);
+        }
+        this.conversionTicketChunk = null;
+        this.conversionTicketKey = null;
     }
+    // TrueOG end
 
