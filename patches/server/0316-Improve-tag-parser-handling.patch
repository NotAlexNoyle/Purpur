--- /dev/null
+++ b/src/test/java/io/papermc/paper/nbt/TagParserDepthTest.java
@@ -0,0 +1,111 @@
+package io.papermc.paper.nbt;
+
+import com.mojang.brigadier.StringReader;
+import com.mojang.brigadier.exceptions.CommandSyntaxException;
+import io.papermc.paper.brigadier.TagParseCommandSyntaxException;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.TagParser;
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+public class TagParserDepthTest {
+
+    @Test
+    public void typedExceptionNamespaceMatchesUpstreamPaper() {
+        assertEquals("io.papermc.paper.brigadier", TagParseCommandSyntaxException.class.getPackage().getName());
+    }
+
+    @Test
+    public void typedExceptionDistinguishableViaInstanceof() {
+        TagParseCommandSyntaxException ex = new TagParseCommandSyntaxException("depth");
+        assertTrue(ex instanceof CommandSyntaxException);
+    }
+
+    @Test
+    public void parse512DeepCompoundSucceeds() throws CommandSyntaxException {
+        String s = repeat("{a:", 512) + "1b" + repeat("}", 512);
+        CompoundTag tag = TagParser.parseTag(s);
+        assertNotNull(tag);
+    }
+
+    @Test
+    public void parse513DeepCompoundThrowsTyped() {
+        String s = repeat("{a:", 513) + "1b" + repeat("}", 513);
+        try {
+            TagParser.parseTag(s);
+            fail("513-deep compound must throw");
+        } catch (CommandSyntaxException e) {
+            assertTrue("expected TagParseCommandSyntaxException, got " + e.getClass().getName(),
+                e instanceof TagParseCommandSyntaxException);
+        }
+    }
+
+    @Test
+    public void parse513DeepListThrowsTyped() {
+        String s = "{a:" + repeat("[", 513) + "1b" + repeat("]", 513) + "}";
+        try {
+            TagParser.parseTag(s);
+            fail("513-deep list must throw");
+        } catch (CommandSyntaxException e) {
+            assertTrue(e instanceof TagParseCommandSyntaxException);
+        }
+    }
+
+    @Test
+    public void parse513DeepMixedCompoundAndListThrowsTyped() {
+        StringBuilder sb = new StringBuilder();
+        StringBuilder closer = new StringBuilder();
+        for (int i = 0; i < 256; i++) {
+            sb.append("{a:[");
+            closer.insert(0, "]}");
+        }
+        sb.append("{a:1b}");
+        closer.insert(0, "");
+        String s = sb.toString() + closer.toString();
+        try {
+            TagParser.parseTag(s);
+            fail("513-deep mixed structure must throw");
+        } catch (CommandSyntaxException e) {
+            assertTrue("expected TagParseCommandSyntaxException, got " + e.getClass().getName(),
+                e instanceof TagParseCommandSyntaxException);
+        }
+    }
+
+    @Test
+    public void siblingStructuresAt512DepthEachDoNotFalselyAccumulate() throws CommandSyntaxException {
+        String deep = repeat("{a:", 511) + "1b" + repeat("}", 511);
+        String s = "{a:" + deep + ",b:" + deep + "}";
+        CompoundTag tag = TagParser.parseTag(s);
+        assertNotNull(tag);
+    }
+
+    @Test
+    public void freshParserResetsDepthBetweenInvocations() throws CommandSyntaxException {
+        String deep = repeat("{a:", 512) + "1b" + repeat("}", 512);
+        CompoundTag first = TagParser.parseTag(deep);
+        assertNotNull(first);
+        CompoundTag second = TagParser.parseTag(deep);
+        assertNotNull(second);
+    }
+
+    @Test
+    public void parseAsStringReaderConstructorAlsoEnforcesBound() {
+        String s = repeat("{a:", 513) + "1b" + repeat("}", 513);
+        try {
+            new TagParser(new StringReader(s)).readStruct();
+            fail("readStruct must enforce the same depth bound as parseTag");
+        } catch (CommandSyntaxException e) {
+            assertTrue(e instanceof TagParseCommandSyntaxException);
+        }
+    }
+
+    private static String repeat(String unit, int n) {
+        StringBuilder sb = new StringBuilder(unit.length() * n);
+        for (int i = 0; i < n; i++) sb.append(unit);
+        return sb.toString();
+    }
+}
