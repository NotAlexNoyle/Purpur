+        Component component = MutableComponent.create(sel);
+        assertFalse(ComponentUtils.isValidSelector(component));
+    }
+
+    @Test
+    public void translatableWithNbtArgIsInvalid() {
+        NbtContents nbt = new NbtContents("foo", false, Optional.empty(), null);
+        MutableComponent nbtComponent = MutableComponent.create(nbt);
+        TranslatableContents tc = new TranslatableContents("purpur.test.nbtarg", "%s", new Object[]{nbtComponent});
+        Component component = MutableComponent.create(tc);
+        assertFalse(ComponentUtils.isValidSelector(component));
+    }
+
+    @Test
+    public void translatableWithSelectorArgIsInvalid() {
+        SelectorContents sel = new SelectorContents("@p", Optional.empty());
+        MutableComponent selComponent = MutableComponent.create(sel);
+        TranslatableContents tc = new TranslatableContents("purpur.test.selarg", "%s", new Object[]{selComponent});
+        Component component = MutableComponent.create(tc);
+        assertFalse(ComponentUtils.isValidSelector(component));
+    }
+
+    @Test
+    public void translatableWithPlainArgIsValid() {
+        TranslatableContents tc = new TranslatableContents("purpur.test.plainarg", "%s",
+            new Object[]{Component.literal("plain")});
+        Component component = MutableComponent.create(tc);
+        assertTrue(ComponentUtils.isValidSelector(component));
+    }
+
+    @Test
+    public void recursionThroughTranslatableArgs() {
+        NbtContents nbt = new NbtContents("foo", false, Optional.empty(), null);
+        MutableComponent nbtComp = MutableComponent.create(nbt);
+        TranslatableContents inner = new TranslatableContents("purpur.test.inner", "%s", new Object[]{nbtComp});
+        MutableComponent innerComp = MutableComponent.create(inner);
+        TranslatableContents outer = new TranslatableContents("purpur.test.outer", "%s", new Object[]{innerComp});
+        Component component = MutableComponent.create(outer);
+        assertFalse("validity check must recurse through nested translatable args",
+            ComponentUtils.isValidSelector(component));
+    }
