+    public static boolean isValidSelector(final Component component) {
+        return isValidSelector(component, 0);
+    }
+    private static boolean isValidSelector(final Component component, final int depth) {
+        // Diverges from upstream Paper: traverses siblings and hover SHOW_TEXT in addition to root contents
+        // and translatable args. updateForEntity itself recurses through siblings and hover text, so any
+        // separator that LOOKS valid at the root but carries an NBT/Selector sibling or hover Component
+        // would still trigger amplification when resolved. Bound recursion at 100 to mirror updateForEntity's
+        // own depth guard; fail-closed on overflow so a pathological tree degrades to an empty separator.
+        if (depth > 100) return false;
+
+        final ComponentContents contents = component.getContents();
+        if (contents instanceof net.minecraft.network.chat.contents.NbtContents || contents instanceof net.minecraft.network.chat.contents.SelectorContents) return false;
+        if (contents instanceof final net.minecraft.network.chat.contents.TranslatableContents translatableContents) {
+            for (final Object arg : translatableContents.getArgs()) {
+                if (arg instanceof final Component argumentAsComponent && !isValidSelector(argumentAsComponent, depth + 1)) return false;
+            }
+        }
+
+        for (final Component sibling : component.getSiblings()) {
+            if (!isValidSelector(sibling, depth + 1)) return false;
+        }
+
+        final HoverEvent hoverEvent = component.getStyle().getHoverEvent();
+        if (hoverEvent != null) {
+            final Component hoverComponent = hoverEvent.getValue(HoverEvent.Action.SHOW_TEXT);
+            if (hoverComponent != null && !isValidSelector(hoverComponent, depth + 1)) return false;
+        }
+
+        return true;
+    }
+    // Paper end - validate separator
