+package io.papermc.paper.network;
+
+import net.minecraft.server.network.ServerGamePacketListenerImpl;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * Verifies the spam-kick predicate used in {@link ServerGamePacketListenerImpl#handleCustomCommandSuggestions}
+ * for long single-token tab-complete requests. The test exercises the real production helper
+ * {@code ServerGamePacketListenerImpl.shouldKickAsSpam(String)} rather than a copy, so wording or
+ * boundary drift in production will fail these tests. The dispatch-ordering property (predicate
+ * runs before the tab-complete executor dispatch) is verified by source inspection at that
+ * location.
+ */
+public class SuggestionSpamKickTest extends AbstractTestingBase {
+
+    @Test
+    public void sixtyFiveCharNoSpaceKicks() {
+        assertTrue(ServerGamePacketListenerImpl.shouldKickAsSpam(repeat('a', 65)));
+    }
+
+    @Test
+    public void twoHundredCharFirstSpaceAt70Kicks() {
+        String cmd = repeat('a', 70) + " " + repeat('b', 129);
+        assertTrue(ServerGamePacketListenerImpl.shouldKickAsSpam(cmd));
+    }
+
+    @Test
+    public void twoHundredCharFirstSpaceAt5Permitted() {
+        String cmd = repeat('a', 5) + " " + repeat('b', 194);
+        assertFalse(ServerGamePacketListenerImpl.shouldKickAsSpam(cmd));
+    }
+
+    @Test
+    public void sixtyFourCharNoSpacePermitted() {
+        assertFalse(ServerGamePacketListenerImpl.shouldKickAsSpam(repeat('a', 64)));
+    }
+
+    private static String repeat(char c, int n) {
+        char[] arr = new char[n];
+        java.util.Arrays.fill(arr, c);
+        return new String(arr);
+    }
+}
