diff --git a/src/test/java/io/papermc/paper/brigadier/DispatcherShortCircuitTest.java b/src/test/java/io/papermc/paper/brigadier/DispatcherShortCircuitTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..7ffc4902c56d8dd3b47b1c93791e66ae8489d019
--- /dev/null
+++ b/src/test/java/io/papermc/paper/brigadier/DispatcherShortCircuitTest.java
@@ -0,0 +1,169 @@
+package io.papermc.paper.brigadier;
+
+import com.mojang.brigadier.CommandDispatcher;
+import com.mojang.brigadier.ParseResults;
+import com.mojang.brigadier.StringReader;
+import com.mojang.brigadier.arguments.ArgumentType;
+import com.mojang.brigadier.builder.LiteralArgumentBuilder;
+import com.mojang.brigadier.builder.RequiredArgumentBuilder;
+import com.mojang.brigadier.exceptions.CommandSyntaxException;
+import com.mojang.brigadier.suggestion.Suggestions;
+import com.mojang.brigadier.suggestion.SuggestionsBuilder;
+import org.junit.Test;
+
+import java.util.Collection;
+import java.util.Collections;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+public class DispatcherShortCircuitTest {
+
+    private static final Object SOURCE = new Object();
+
+    @Test
+    public void typedExceptionPropagatesIntoExceptionMap() {
+        CommandDispatcher<Object> dispatcher = new CommandDispatcher<>();
+        LiteralArgumentBuilder<Object> root = LiteralArgumentBuilder.literal("nbt");
+        ArgumentType<Object> typedThrower = new ThrowingArgumentType(true);
+        RequiredArgumentBuilder<Object, Object> arg = RequiredArgumentBuilder.argument("payload", typedThrower);
+        arg.executes(ctx -> 0);
+        root.then(arg);
+        dispatcher.register(root);
+
+        ParseResults<Object> results = dispatcher.parse("nbt {foo:bar}", SOURCE);
+
+        assertFalse("typed-throw must record into exceptions map", results.getExceptions().isEmpty());
+        boolean found = results.getExceptions().values().stream()
+            .anyMatch(e -> e instanceof TagParseCommandSyntaxException);
+        assertTrue("ParseResults exception map must contain TagParseCommandSyntaxException", found);
+    }
+
+    @Test
+    public void genericRuntimeExceptionDoesNotShortCircuitOrProduceTypedException() {
+        CommandDispatcher<Object> dispatcher = new CommandDispatcher<>();
+        LiteralArgumentBuilder<Object> root = LiteralArgumentBuilder.literal("nbt");
+        ArgumentType<Object> genericThrower = new ThrowingArgumentType(false);
+        RequiredArgumentBuilder<Object, Object> arg = RequiredArgumentBuilder.argument("payload", genericThrower);
+        arg.executes(ctx -> 0);
+        root.then(arg);
+        dispatcher.register(root);
+
+        ParseResults<Object> results = dispatcher.parse("nbt {foo:bar}", SOURCE);
+
+        assertNotNull(results);
+        boolean typed = results.getExceptions().values().stream()
+            .anyMatch(e -> e instanceof TagParseCommandSyntaxException);
+        assertFalse("generic RuntimeException must not be reported as a typed NBT exception", typed);
+    }
+
+    @Test
+    public void typedExceptionSkipsAlternateChild() {
+        AtomicBoolean alternateAttempted = new AtomicBoolean(false);
+
+        CommandDispatcher<Object> dispatcher = new CommandDispatcher<>();
+        // Brigadier merges argument nodes by name on registration, so the two alternative
+        // argument paths must use DISTINCT names to coexist as siblings under the same literal.
+        // Paper rewires CommandNode.children to a TreeMap (alphabetical sort), so the alphabetical
+        // ordering of argument names determines iteration order: the throwing argument is named
+        // with an 'a' prefix to ensure it is iterated before the instrumented one.
+        LiteralArgumentBuilder<Object> root = LiteralArgumentBuilder.literal("danger");
+        RequiredArgumentBuilder<Object, Object> firstArg = RequiredArgumentBuilder.argument(
+            "aThrowingArg", new ThrowingArgumentType(true));
+        firstArg.executes(ctx -> 0);
+        root.then(firstArg);
+
+        RequiredArgumentBuilder<Object, Object> secondArg = RequiredArgumentBuilder.argument(
+            "zInstrumentedArg", new InstrumentedArgumentType(alternateAttempted));
+        secondArg.executes(ctx -> 0);
+        root.then(secondArg);
+
+        dispatcher.register(root);
+
+        ParseResults<Object> results = dispatcher.parse("danger anything", SOURCE);
+
+        assertTrue("typed exception must reach the exceptions map",
+            results.getExceptions().values().stream().anyMatch(e -> e instanceof TagParseCommandSyntaxException));
+        assertFalse("alternate child must NOT be attempted after a typed NBT exception",
+            alternateAttempted.get());
+    }
+
+    @Test
+    public void genericRuntimeExceptionAllowsAlternateChild() {
+        AtomicBoolean alternateAttempted = new AtomicBoolean(false);
+
+        CommandDispatcher<Object> dispatcher = new CommandDispatcher<>();
+        LiteralArgumentBuilder<Object> root = LiteralArgumentBuilder.literal("danger");
+        RequiredArgumentBuilder<Object, Object> firstArg = RequiredArgumentBuilder.argument(
+            "aThrowingArg", new ThrowingArgumentType(false));
+        firstArg.executes(ctx -> 0);
+        root.then(firstArg);
+
+        RequiredArgumentBuilder<Object, Object> secondArg = RequiredArgumentBuilder.argument(
+            "zInstrumentedArg", new InstrumentedArgumentType(alternateAttempted));
+        secondArg.executes(ctx -> 0);
+        root.then(secondArg);
+
+        dispatcher.register(root);
+
+        dispatcher.parse("danger anything", SOURCE);
+
+        assertTrue("alternate child must be attempted after a generic RuntimeException",
+            alternateAttempted.get());
+    }
+
+    private static final class InstrumentedArgumentType implements ArgumentType<Object> {
+        private final AtomicBoolean tried;
+
+        private InstrumentedArgumentType(AtomicBoolean tried) {
+            this.tried = tried;
+        }
+
+        @Override
+        public Object parse(StringReader reader) throws CommandSyntaxException {
+            this.tried.set(true);
+            // consume the rest of the input so the parse appears to "succeed"
+            while (reader.canRead()) reader.skip();
+            return new Object();
+        }
+
+        @Override
+        public <S> CompletableFuture<Suggestions> listSuggestions(com.mojang.brigadier.context.CommandContext<S> context, SuggestionsBuilder builder) {
+            return Suggestions.empty();
+        }
+
+        @Override
+        public Collection<String> getExamples() {
+            return Collections.emptyList();
+        }
+    }
+
+    private static final class ThrowingArgumentType implements ArgumentType<Object> {
+        private final boolean throwTyped;
+
+        private ThrowingArgumentType(boolean throwTyped) {
+            this.throwTyped = throwTyped;
+        }
+
+        @Override
+        public Object parse(StringReader reader) throws CommandSyntaxException {
+            if (throwTyped) {
+                throw new TagParseCommandSyntaxException("NBT tag is too complex, depth > 512");
+            }
+            throw new RuntimeException("boom");
+        }
+
+        @Override
+        public <S> CompletableFuture<Suggestions> listSuggestions(com.mojang.brigadier.context.CommandContext<S> context, SuggestionsBuilder builder) {
+            return Suggestions.empty();
+        }
+
+        @Override
+        public Collection<String> getExamples() {
+            return Collections.emptyList();
+        }
+    }
+}
