new file mode 100644
index 0000000000000000000000000000000000000000..b33a710a856351a0cbd91258a18578f26a5365db
--- /dev/null
+++ b/src/test/java/io/papermc/paper/chat/TranslatableContentsVisitCapTest.java
@@ -0,0 +1,72 @@
+package io.papermc.paper.chat;
+
+import net.minecraft.network.chat.MutableComponent;
+import net.minecraft.network.chat.contents.TranslatableContents;
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class TranslatableContentsVisitCapTest {
+
+    @Test
+    public void selfReferentialArgumentTerminatesWithEllipsis() {
+        // Fallback must include literal text around the %s so each recursion level emits an accept(),
+        // which is what drives the visit counter. A pure "%s" fallback decomposes to a single Component
+        // part (the arg) and skips accept() entirely, so the counter never trips and pure-Component
+        // recursion would StackOverflowError — matching upstream Paper's same limitation but irrelevant
+        // in practice because the network protocol caps Component JSON depth so reference cycles like
+        // this aren't constructible by clients. The cap is what guards player-supplied components whose
+        // fallbacks (or resolved translations) carry literal text around args.
+        Object[] args = new Object[1];
+        TranslatableContents tc = new TranslatableContents("purpur.test.self_ref", "[%s]", args);
+        args[0] = MutableComponent.create(tc);
+
+        List<String> collected = new ArrayList<>();
+        tc.visit(s -> {
+            collected.add(s);
+            return Optional.empty();
+        });
+
+        assertTrue("self-referential translation must terminate", collected.size() > 0);
+        assertTrue("self-referential translation must end with '...' placeholder",
+            collected.contains("..."));
+    }
+
+    @Test
+    public void crossReferentialChainTerminates() {
+        Object[] argsX = new Object[1];
+        Object[] argsY = new Object[1];
+        TranslatableContents tcX = new TranslatableContents("purpur.test.cross_x", "<%s>", argsX);
+        TranslatableContents tcY = new TranslatableContents("purpur.test.cross_y", "<%s>", argsY);
+        argsX[0] = MutableComponent.create(tcY);
+        argsY[0] = MutableComponent.create(tcX);
+
+        List<String> collected = new ArrayList<>();
+        tcX.visit(s -> {
+            collected.add(s);
+            return Optional.empty();
+        });
+
+        assertTrue("X->Y->X chain must terminate", collected.size() > 0);
+        assertTrue("X->Y->X chain must end with '...' placeholder",
+            collected.contains("..."));
+    }
+
+    @Test
+    public void shortLegitimateComponentRendersWithoutEllipsis() {
+        TranslatableContents tc = new TranslatableContents("purpur.test.short", "hello world", new Object[0]);
+
+        List<String> collected = new ArrayList<>();
+        tc.visit(s -> {
+            collected.add(s);
+            return Optional.empty();
+        });
+
+        assertFalse("legitimate short component must not emit '...'", collected.contains("..."));
+    }
+}
