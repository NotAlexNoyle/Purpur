@@ -0,0 +1,68 @@
+package io.papermc.paper.network;
+
+import com.mojang.brigadier.CommandDispatcher;
+import com.mojang.brigadier.ParseResults;
+import com.mojang.brigadier.builder.LiteralArgumentBuilder;
+import com.mojang.brigadier.builder.RequiredArgumentBuilder;
+import com.mojang.brigadier.context.CommandContextBuilder;
+import io.papermc.paper.brigadier.TagParseCommandSyntaxException;
+import net.minecraft.server.network.ServerGamePacketListenerImpl;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+import java.util.LinkedHashMap;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * Verifies the exception-map inspection predicate used in
+ * {@link ServerGamePacketListenerImpl#handleCustomCommandSuggestions} to short-circuit a
+ * tab-complete request when the dispatcher parse surfaced a non-recoverable NBT exception.
+ * Exercises the real production helper {@code ServerGamePacketListenerImpl.hasTypedNbtException(ParseResults)}
+ * rather than a copy, so the test fails if the production predicate drifts. The disconnect
+ * side-effect and the early-return-before-getCompletionSuggestions are verified by source
+ * inspection at that location.
+ */
+public class SuggestionHandlerTypedExceptionTest extends AbstractTestingBase {
+
+    @Test
+    public void typedExceptionInMapIsDetected() {
+        ParseResults<Object> results = parseResultsWith(new TagParseCommandSyntaxException("test"));
+        assertTrue(ServerGamePacketListenerImpl.hasTypedNbtException(results));
+    }
+
+    @Test
+    public void genericCommandSyntaxExceptionIsNotDetected() {
+        ParseResults<Object> results = parseResultsWith(
+            com.mojang.brigadier.exceptions.CommandSyntaxException.BUILT_IN_EXCEPTIONS
+                .literalIncorrect().create("test"));
+        assertFalse(ServerGamePacketListenerImpl.hasTypedNbtException(results));
+    }
+
+    @Test
+    public void emptyExceptionMapIsNotDetected() {
+        ParseResults<Object> results = parseResultsWith(null);
+        assertFalse(ServerGamePacketListenerImpl.hasTypedNbtException(results));
+    }
+
+    private static ParseResults<Object> parseResultsWith(com.mojang.brigadier.exceptions.CommandSyntaxException ex) {
+        CommandDispatcher<Object> dispatcher = new CommandDispatcher<>();
+        LiteralArgumentBuilder<Object> root = LiteralArgumentBuilder.literal("test");
+        RequiredArgumentBuilder<Object, Integer> arg = RequiredArgumentBuilder.argument("arg",
+            com.mojang.brigadier.arguments.IntegerArgumentType.integer());
+        arg.executes(ctx -> 0);
+        root.then(arg);
+        dispatcher.register(root);
+
+        LinkedHashMap<com.mojang.brigadier.tree.CommandNode<Object>,
+            com.mojang.brigadier.exceptions.CommandSyntaxException> errors = new LinkedHashMap<>();
+        if (ex != null) {
+            com.mojang.brigadier.tree.CommandNode<Object> child = dispatcher.getRoot().getChild("test");
+            errors.put(child, ex);
+        }
+        com.mojang.brigadier.context.CommandContextBuilder<Object> ctx =
+            new CommandContextBuilder<>(dispatcher, new Object(), dispatcher.getRoot(), 0);
+        return new ParseResults<>(ctx, new com.mojang.brigadier.StringReader("test"), errors);
+    }
+}
